# ────────────────────────────────────────────
#  Variables de entorno — App Reservas
#  Copiar este archivo como .env y completar
# ────────────────────────────────────────────

# --- Base de datos PostgreSQL ---
POSTGRES_DB=serviciosweb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend FastAPI ---
# Clave secreta JWT: cambia esto en producción (mínimo 32 caracteres aleatorios)
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_SECRETA_EN_PRODUCCION

# --- Usuario administrador inicial ---
ADMIN_EMAIL=admin@itm.edu.co
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador
